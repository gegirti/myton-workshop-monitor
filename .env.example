# Copy to /etc/workshop-monitor.env (recommended) and insert real values there.
# Do not commit the real environment file.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=123456789

UPS_NAME=myton@localhost
UPS_WATTS=2700
BASELINE_WATTS=27
POWER_SAMPLE_INTERVAL=5
CALIBRATION_DURATION=300
CALIBRATION_SAMPLE_INTERVAL=5
UPS_MONITOR_INTERVAL=5
NUT_TIMEOUT=5
NUT_FAILURE_WARNING_THRESHOLD=3
DATA_DIR=data
